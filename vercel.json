{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/download/eblood.apk", "destination": "https://github.com/ashikbillah4300-ops/EBloodDonation/releases/download/latest/EBloodDonation-debug.apk", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/backend/public/admin.html" },
    { "source": "/admin-panel", "destination": "/backend/public/admin.html" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/download/(.*)", "destination": "/api/index.js" }
  ]
}
