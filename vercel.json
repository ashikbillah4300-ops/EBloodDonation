{
  "version": 2,
  "builds": [
    {
      "src": "backend/src/server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["backend/public/**"]
      }
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/admin-panel",
      "dest": "backend/src/server.js"
    },
    {
      "src": "/(.*)",
      "dest": "backend/src/server.js"
    }
  ]
}
