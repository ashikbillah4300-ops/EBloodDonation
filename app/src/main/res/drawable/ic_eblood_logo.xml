                android:startX="24"
                android:startY="14"
                android:endX="50"
                android:endY="86"
                android:type="linear">
                <item android:offset="0.0" android:color="#A0FFFFFF" />
                <item android:offset="1.0" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- White Heart symbol of Care & Life -->
    <path
        android:pathData="M50,74 C50,74 34,62 34,51 C34,44.5 39,40 45,40 C48,40 50,42.5 50,42.5 C50,42.5 52,40 55,40 C61,40 66,44.5 66,51 C66,62 50,74 50,74 Z"
        android:fillColor="#FFFFFF" />

    <!-- Emergency Medical Ruby Cross in Center of Heart -->
    <path
        android:pathData="M47.5,46.5 H52.5 V50 H56 V54 H52.5 V58 H47.5 V54 H44 V50 H47.5 Z"
        android:fillColor="#E11D48" />

</vector>
