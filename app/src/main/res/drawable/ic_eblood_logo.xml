        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="20"
                android:startY="8"
                android:endX="80"
                android:endY="93"
                android:type="linear">
                <item android:offset="0.0" android:color="#FFFF2E55" />
                <item android:offset="0.55" android:color="#FFE11D48" />
                <item android:offset="1.0" android:color="#FF9F1239" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular 3D Highlight curve on left curve -->
    <path
        android:pathData="M50,14 C47,20 25,52 24,67 C23,76 27,83 33,86 C27,81 24,73 25,65 C26,52 46,23 50,14 Z">
        <aapt:attr name="android:fillColor">
