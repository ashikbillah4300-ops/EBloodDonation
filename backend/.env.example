# ==========================================
# EBloodDonation Backend Configuration
# ==========================================

# Server Port and Environment
PORT=5000
NODE_ENV=production

# PostgreSQL Database Connection URL (e.g. Neon, Render PostgreSQL, Supabase)
DATABASE_URL=postgresql://eblood_user:your_password@ep-sample-pooler.us-east-2.aws.neon.tech/eblood_db?sslmode=require

# Alternatively use individual PostgreSQL credentials:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=eblood_db
# DB_USER=postgres
# DB_PASSWORD=your_password

# Authentication & Security
JWT_SECRET=replace_with_a_secure_long_random_jwt_secret_token_here
JWT_EXPIRES_IN=30d
ALLOWED_ORIGINS=https://eblooddonation.onrender.com,http://localhost:3000,http://localhost:5000

# Initial Admin Credentials (Setup only; hashed with bcrypt in DB)
DEFAULT_ADMIN_USERNAME=ashikbillah4300@gmail.com
DEFAULT_ADMIN_EMAIL=ashikbillah4300@gmail.com
DEFAULT_ADMIN_PASSWORD=your_secure_admin_password_here

# Firebase Admin SDK (For real FCM urgent blood alerts & Phone Auth verification)
# Do not commit real private keys to git; configure in Render / cloud dashboard environment variables.
FIREBASE_PROJECT_ID=eblooddonation-6af67
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@eblooddonation-6af67.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYourPrivateKeyHere\n-----END PRIVATE KEY-----\n"

# Contact & Wallet Defaults
DEFAULT_DONATION_NUMBER=WALLET-01969114300
DEFAULT_CONTACT_NUMBER=+8801969114300
DEFAULT_SUPPORT_NUMBER=+8801969114300
DEFAULT_SUPPORT_EMAIL=support@eblood.org
