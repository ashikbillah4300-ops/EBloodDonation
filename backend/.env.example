PORT=5000
NODE_ENV=development

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=eblood_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DATABASE_URL=postgres://postgres:your_secure_password@localhost:5432/eblood_db

# Security & JWT
JWT_SECRET=your_super_secret_jwt_key_eblood_2026
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Seeded automatically on first run)
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@eblood.org
DEFAULT_ADMIN_PASSWORD=eblood@2026
